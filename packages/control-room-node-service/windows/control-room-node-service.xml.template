<service>
  <id>control-room-node</id>
  <name>Control Room Node Bridge</name>
  <description>Value-free template; installation requires owner approval.</description>
  <executable>{{CONTROL_ROOM_NODE_RUNTIME}}</executable>
  <arguments>{{CONTROL_ROOM_NODE_RELEASE_DIR}}/node-service.js --config {{CONTROL_ROOM_NODE_CONFIG_PATH}}</arguments>
  <workingdirectory>{{CONTROL_ROOM_NODE_RELEASE_DIR}}</workingdirectory>
  <log mode="roll" />
  <onfailure action="restart" delay="5 sec" />
  <stoptimeout>30sec</stoptimeout>
</service>
