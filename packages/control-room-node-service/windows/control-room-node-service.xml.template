<!-- Platform: windows-user-context-wrapper; profile loading and Job Object enforcement require owner-run native evidence. -->
<!-- Historical continuous-service design reference. NON-INSTALLABLE.
     Do not substitute the one-task launcher; automatic restart is not recovery authority. -->
<service>
  <id>control-room-node</id>
  <name>Control Room Node Bridge</name>
  <description>Historical reference only. Continuous service is not implemented.</description>
  <executable>{{CONTROL_ROOM_NODE_RUNTIME}}</executable>
  <arguments>{{CONTROL_ROOM_NODE_RELEASE_DIR}}/node-service.js --config {{CONTROL_ROOM_NODE_CONFIG_PATH}}</arguments>
  <workingdirectory>{{CONTROL_ROOM_NODE_RELEASE_DIR}}</workingdirectory>
  <log mode="roll" />
  <stoptimeout>30sec</stoptimeout>
</service>
