# Paths only. Never put secret values in this file.
ACR_GITHUB_BROKER_SETTINGS_FILE=/etc/control-room/github-worker-broker.settings.json
ACR_GITHUB_APP_PRIVATE_KEY_FILE=/etc/control-room/secrets/github-app-private-key.pem
ACR_GITHUB_WEBHOOK_SECRET_FILE=/etc/control-room/secrets/github-webhook-secret
ACR_GITHUB_WORKER_READ_SECRET_FILE=/etc/control-room/secrets/github-worker-read-secret
ACR_GITHUB_DATABASE_PASSWORD_FILE=/etc/control-room/secrets/github-broker-database-password
