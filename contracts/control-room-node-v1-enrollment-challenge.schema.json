{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-room.invalid/contracts/control-room-node-v1-enrollment-challenge.schema.json",
  "title": "Control Room node enrollment challenge v1",
  "type": "object",
  "properties": {
    "challengeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "challengeNonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "supportedProtocols": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "serverTrustKeys": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "algorithm": {
            "type": "string",
            "const": "ed25519"
          },
          "spki": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "keyId",
          "algorithm",
          "spki"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "challengeId",
    "challengeNonce",
    "issuedAt",
    "expiresAt",
    "supportedProtocols",
    "serverTrustKeys"
  ],
  "additionalProperties": false
}
