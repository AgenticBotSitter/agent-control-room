{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-room.invalid/contracts/control-room-wire-denial-receipt-v1.schema.json",
  "title": "Control Room safe wire denial receipt v1",
  "description": "Generated from control-room-node-policy/v1 strict validators. Cryptographic digest/signature and cross-artifact invariants are enforced by contract code and tests.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "control-room-node-policy/v1"
    },
    "receiptId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "relatedMessageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "jobId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "attemptId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "policy",
        "expired",
        "approval_required",
        "effect_in_progress",
        "ambiguous",
        "maintenance",
        "storage"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "contractVersion",
    "receiptId",
    "relatedMessageId",
    "jobId",
    "attemptId",
    "category",
    "occurredAt"
  ],
  "additionalProperties": false
}
