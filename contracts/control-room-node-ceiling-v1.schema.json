{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-room.invalid/contracts/control-room-node-ceiling-v1.schema.json",
  "title": "Control Room signed node authority ceiling v1",
  "description": "Generated from control-room-node-policy/v1 strict validators. Cryptographic digest/signature and cross-artifact invariants are enforced by contract code and tests.",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "control-room.node-authority-ceiling/v1"
        },
        "tenantId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "issuerKeyId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "projectIds": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          }
        },
        "executorIds": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          }
        },
        "operationIds": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          }
        },
        "credentialRefs": {
          "minItems": 0,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          }
        },
        "filesystemRoots": {
          "minItems": 0,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "networkDestinations": {
          "minItems": 0,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 12,
            "maxLength": 300
          }
        },
        "maxRisk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "externalEffects": {
          "type": "string",
          "enum": [
            "none",
            "preauthorized",
            "approval_required"
          ]
        },
        "maxDurationSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 31536000
        },
        "maxConcurrentEffects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxCostUsd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{0,5}[1-9])?$"
        },
        "bodyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "tenantId",
        "nodeId",
        "version",
        "issuedAt",
        "issuerKeyId",
        "projectIds",
        "executorIds",
        "operationIds",
        "credentialRefs",
        "filesystemRoots",
        "networkDestinations",
        "maxRisk",
        "externalEffects",
        "maxDurationSeconds",
        "maxConcurrentEffects",
        "bodyDigest"
      ],
      "additionalProperties": false
    },
    "signatureAlgorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "body",
    "signatureAlgorithm",
    "signature"
  ],
  "additionalProperties": false
}
