{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-room.invalid/contracts/control-room-server-trust-bundle-v1.schema.json",
  "title": "Control Room owner-signed server trust bundle v1",
  "description": "Generated from control-room-node-policy/v1 strict validators. Cryptographic digest/signature and cross-artifact invariants are enforced by contract code and tests.",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "control-room.server-trust-bundle/v1"
        },
        "tenantId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "nodeClass": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "epoch": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "ownerRootKeyId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "keys": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 180,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "algorithm": {
                "type": "string",
                "const": "ed25519"
              },
              "spki": {
                "type": "string",
                "minLength": 16,
                "maxLength": 16384,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "active",
                  "retired",
                  "revoked"
                ]
              }
            },
            "required": [
              "keyId",
              "algorithm",
              "spki",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "bodyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "tenantId",
        "nodeClass",
        "epoch",
        "issuedAt",
        "ownerRootKeyId",
        "keys",
        "bodyDigest"
      ],
      "additionalProperties": false
    },
    "signatureAlgorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "shrinkAuthorization": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "bundleBodyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signatureAlgorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "keyId",
        "bundleBodyDigest",
        "signatureAlgorithm",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "body",
    "signatureAlgorithm",
    "signature"
  ],
  "additionalProperties": false
}
