{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-room.invalid/contracts/control-room-owner-approval-attestation-v1.schema.json",
  "title": "Control Room owner approval attestation v1",
  "description": "Generated from control-room-node-policy/v1 strict validators. Cryptographic digest/signature and cross-artifact invariants are enforced by contract code and tests.",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "control-room.owner-approval-attestation/v1"
        },
        "tenantId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "nodeClass": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "projectId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "jobId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "operationDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "decision": {
          "type": "string",
          "const": "approved"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "approvalKeyId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "bodyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "tenantId",
        "projectId",
        "jobId",
        "attemptId",
        "operationDigest",
        "risk",
        "decision",
        "issuedAt",
        "expiresAt",
        "nonce",
        "approvalKeyId",
        "bodyDigest"
      ],
      "additionalProperties": false
    },
    "signatureAlgorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "body",
    "signatureAlgorithm",
    "signature"
  ],
  "additionalProperties": false
}
