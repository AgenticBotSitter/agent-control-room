# Operator environment for the unprivileged Control Room host.
#
# Copy to ~/.config/control-room/operator.env, `chmod 600`, and edit the values.
# These are FILE PATHS and non-secret switches only. Secrets are never placed in
# this file; the service reads credentials from its configuration module, which
# must be owner-only (0600) and must not be a symlink.

# Absolute path to the operator configuration module (mode 0600, no symlinks).
CONTROL_ROOM_CONFIGURATION=%h/control-room-config.mjs

# Release root: holds releases/, current/, state/, uncertain/.
# Must be inside the operator's home so the unit needs no elevation.
CONTROL_ROOM_ROOT=%h/control-room

# Loopback port the host binds. Loopback only; never a public interface.
CONTROL_ROOM_PORT=8787

# Node binary used by the unit. Must be an absolute path.
CONTROL_ROOM_NODE=%h/.local/bin/node

# Where the release path writes its bounded log.
CONTROL_ROOM_LOG=%h/control-room/update.log

# Minimum Node version the release was built and verified against.
CONTROL_ROOM_MIN_NODE=22.13.0