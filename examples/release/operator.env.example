# EXAMPLE environment file — placeholder names only, no real values.
# If your operator setup reads env (rather than a secret manager), copy this
# file outside the repo, fill it in, chmod 0600. Never commit the filled copy.
# The release scripts never read this file; it is documentation of the names
# an operator configuration may need.
CONTROL_ROOM_PORT=3000
CONTROL_ROOM_PG_HOST=127.0.0.1
CONTROL_ROOM_PG_PORT=5432
CONTROL_ROOM_PG_DATABASE=control_room
CONTROL_ROOM_PG_USER=control_room_app
# Set via your secret manager at deploy time, never in a file:
# CONTROL_ROOM_PG_PASSWORD
# R2 / S3-compatible credentials for files and backups:
# CONTROL_ROOM_FILES_ENDPOINT, CONTROL_ROOM_FILES_KEY_ID, CONTROL_ROOM_FILES_SECRET
