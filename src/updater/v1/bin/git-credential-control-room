#!/bin/sh -p
set -efu
[ "$#" -eq 2 ] || exit 64
CREDENTIAL=$1
OPERATION=$2
[ "$OPERATION" = get ] || exit 0
case "$CREDENTIAL" in /*) ;; *) exit 64 ;; esac
# Production verifies the root-owned credential. The source's local
# integration test selects its unprivileged fixture owner only in testing.
EXPECTED_UID=${CONTROL_ROOM_TEST_CREDENTIAL_UID:-0}
case "$EXPECTED_UID" in ''|*[!0-9]*) exit 64 ;; esac
DETAILS=$(/usr/bin/stat -f '%u %Lp %l %HT' "$CREDENTIAL") || exit 1
[ "$DETAILS" = "$EXPECTED_UID 600 1 Regular File" ] || exit 1
IFS= read -r TOKEN < "$CREDENTIAL" || exit 1
case "$TOKEN" in ''|*[!A-Za-z0-9._~-]*) exit 1 ;; esac
[ "${#TOKEN}" -le 16384 ] || exit 1
/usr/bin/printf 'username=x-access-token\npassword=%s\n\n' "$TOKEN"
