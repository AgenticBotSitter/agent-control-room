{
  "name": "control-room",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --import tsx --test tests/contract.test.ts tests/domain-contract.test.ts tests/scheduler.test.ts tests/persistence.test.ts tests/canonical-persistence.test.ts tests/security.test.ts tests/audit-config.test.ts tests/node-protocol.test.ts tests/node-policy-contract.test.ts tests/node-protected-stores.test.ts tests/node-security-state.test.ts tests/node-bridge.test.ts",
    "test:build": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "check": "tsc --noEmit",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "domain:generate": "tsx scripts/generate-domain-schema.ts",
    "protocol:generate": "tsx scripts/generate-node-protocol-schema.ts",
    "policy:generate": "tsx scripts/generate-node-policy-schema.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
